msgid "— Select —"
msgstr "— Pilih —"

#. Translators: %d is a number.
msgid "%d day"
msgid_plural "%d days"
msgstr[0] "%d hari"
msgstr[1] "%d hari"

msgid "180 days"
msgstr "180 hari"

msgid "601155898464"
msgstr "601155898464"

msgid "A click does not confirm that a WhatsApp message was sent. Analytics and campaign attribution require visitor consent."
msgstr "Klik tidak mengesahkan bahawa mesej WhatsApp telah dihantar. Analitik dan atribusi kempen memerlukan persetujuan pelawat."

msgid "Accept"
msgstr "Terima"

msgid "Actions"
msgstr "Tindakan"

msgid "Activate"
msgstr "Aktifkan"

msgid "Active"
msgstr "Aktif"

msgid "Add Contact"
msgstr "Tambah kenalan"

msgid "Allow analytics"
msgstr "Benarkan analitik"

msgid "Analytics"
msgstr "Analitik"

msgid "Analytics accepted."
msgstr "Analitik diterima."

msgid "Analytics data is not sent by Hatnikotni Chat to an external analytics service. When a visitor chooses to contact the site through WhatsApp, the browser is redirected to WhatsApp and that service receives information according to its own privacy policy and terms."
msgstr "Hatnikotni Chat tidak menghantar data analitik kepada perkhidmatan analitik luaran. Apabila pelawat memilih untuk menghubungi laman melalui WhatsApp, pelayar akan dialihkan ke WhatsApp dan perkhidmatan itu menerima maklumat mengikut dasar privasi serta syaratnya sendiri."

msgid "Analytics events are stored in the site WordPress database and are automatically deleted after 180 days. With analytics consent, the plugin may use the first-party hatnch_campaign cookie for up to 30 days to retain the latest supported UTM campaign attribution."
msgstr "Peristiwa analitik disimpan dalam pangkalan data WordPress laman dan dipadam secara automatik selepas 180 hari. Dengan persetujuan analitik, plugin boleh menggunakan kuki pihak pertama hatnch_campaign sehingga 30 hari untuk mengekalkan atribusi kempen UTM terkini yang disokong."

msgid "Analytics rejected. WhatsApp remains available."
msgstr "Analitik ditolak. WhatsApp tetap tersedia."

msgid "Analytics summary"
msgstr "Ringkasan analitik"

msgid "Apply"
msgstr "Gunakan"

msgid "Bottom left"
msgstr "Bawah kiri"

msgid "Bottom right"
msgstr "Bawah kanan"

msgid "Broad device categories only."
msgstr "Kategori peranti umum sahaja."

msgid "Button & message"
msgstr "Butang dan mesej"

msgid "Button Label"
msgstr "Label butang"

msgid "Button Position"
msgstr "Kedudukan butang"

